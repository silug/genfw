our $VERSION="1.52.1";

our %interface=();
our %conf=();

# The generated ruleset. generate_rules() records what the firewall should
# contain here, as iptables-style argument lists keyed by table and chain,
# and an output backend formats it at the end. Adding another backend (an
# "nft -f" formatter, say) means adding a formatter and an apply command to
# %backend, not touching the code that decides what the rules are.
our %ruleset=();
our @pending_comments=();
our @tables=qw(filter nat mangle raw);
our %builtin=(
        'filter' => [qw(INPUT FORWARD OUTPUT)],
        'nat'    => [qw(PREROUTING INPUT OUTPUT POSTROUTING)],
        'mangle' => [qw(PREROUTING INPUT FORWARD OUTPUT POSTROUTING)],
        'raw'    => [qw(PREROUTING OUTPUT)],
    );
our %backend=(
        'iptables-restore' => {
            'format' => \&format_iptables_restore,
            'test'   => ['iptables-restore', '--test'],
            'apply'  => ['iptables-restore'],
        },
    );
our $output='iptables-restore';
our $sysconfig_dir;   # holds network-scripts/
our $config_dir;      # holds rules, rules.d/, and include targets
our %opt=();

getopts('c:di', \%opt)
    or die "Usage: genfw [-c config-dir] [-d] [-i]\n";

if (defined($ENV{'DEBUG'}) || $opt{'d'}) {
    $sysconfig_dir=".";
    $config_dir="./genfw";
    $|=1;
    my $oldfh=select(STDERR);
    $|=1;
    select($oldfh);
} else {
    $sysconfig_dir="/etc/sysconfig";
    # /etc/genfw is the canonical location. /etc/sysconfig/genfw is where it
    # lived historically (and where the RPM still creates the directory); it
    # is used when /etc/genfw does not exist.
    $config_dir=default_config_dir("/etc/genfw", "$sysconfig_dir/genfw");
}

if (defined($opt{'c'})) {
    -d $opt{'c'}
        or die "Configuration directory $opt{'c'} does not exist.\n";
    $config_dir=$opt{'c'};
}

# Default
$conf{'log'}=[qw(-m limit -j LOG)];

$conf{'policy'}={
        'INPUT'         => 'DROP',
        'OUTPUT'        => 'ACCEPT',
        'FORWARD'       => 'DROP',
    };

$conf{'genfw_chains'}=[
        'acceptnew',
        'established',
        'icmp-filter',
    ];

$conf{'chain'}={
        'acceptnew'     => "Allow new connections.",
        'established'   => "Allow established connections.",
        'icmp-filter'   => "Filter ICMP traffic.",
    };

my $rules_found=0;
for my $rules ("$config_dir/rules",
               glob("$config_dir/rules.d/*.rules")) {
    if (-e $rules) {
        parserules($rules);
        $rules_found=1;
    }
}

die "No rules found in $config_dir!  Exiting...\n" if (!$rules_found);

# Where interface addresses come from: "ifcfg" reads the Red Hat
# network-scripts files, "ip" asks the running kernel through ip(8). The
# rules file can choose with an "addresses" line; otherwise use ifcfg when
# any ifcfg-* file exists and ip when none do.
my $source=$conf{'addresses'};
if (!defined($source)) {
    my @ifcfg=glob("$sysconfig_dir/network-scripts/ifcfg-*");
    $source=@ifcfg ? "ifcfg" : "ip";
    debug "Interface addresses from '$source' (auto-detected).";
}

for my $name (keys(%interface)) {
    if (exists($interface{$name}->{'flags'}->{'ignore'})) {
        debug "Skipping interface $name";
        debug;
        next;
    }

    push(@{$interface{$name}->{'cfg'}},
         $source eq "ifcfg" ? ifcfg_addresses($name) : ip_addresses($name));

    for my $cfg (@{$interface{$name}->{'cfg'}}) {
        debug "interface $name";
        if (defined($cfg->{'ipaddr'})) {
            debug "  address " . $cfg->{'ipaddr'};
            debug "  netmask " . $cfg->{'netmask'};
            debug "  network " . $cfg->{'network'};
            debug "  broadcast " . $cfg->{'broadcast'};
        } else {
            debug "  dynamically configured";
        }
    }
    debug;
}

if ($ENV{'DEBUG'}) {
    eval {
        require Data::Dumper;
        debug Data::Dumper::Dumper(\%interface);
    };
}

generate_rules(%interface);

my $text=$backend{$output}->{'format'}->(\%ruleset);

if ($opt{'i'}) {
    # Check the whole ruleset first. The loader commits one table at a
    # time, so without this an error in a later table would leave earlier
    # tables already replaced.
    apply_ruleset($text, @{$backend{$output}->{'test'}})
        if ($backend{$output}->{'test'});
    apply_ruleset($text, @{$backend{$output}->{'apply'}});
} else {
    print $text;
}

####
#
# Subs
#

sub reject_auth {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out),
           qw(-p tcp --dport 113 -j REJECT --reject-with tcp-reset);
    rule label($in) . "-" . label($out),
           qw(-p udp --dport 113 -j REJECT --reject-with icmp-port-unreachable);
}

sub check_allowed {
    my ($in, $out)=@_;

    debug "checking for allowed traffic to interface $out";

    my $allow=$interface{$out}->{'flags'}->{'allow'};
    return if (!$allow or !@{$allow});

    my @open_port;

    for my $item (@{$allow}) {
        my ($port, $proto, $from, $to, $interface)=
            @{$item}{qw(port proto from to interface)};

        next if ($interface and $interface ne $in);
        next if (!defined($port) or !length($port));

        if (!$proto) {
            if ($port=~/^\d+$/) {
                warn "ambiguous allow '$port', ignoring...\n";
                next;
            }
            my $found=0;
            for my $proto ("tcp", "udp") {
                if (getservbyname($port, $proto)) {
                    push(@open_port, [$port, $proto, $from, $to]);
                    $found++;
                }
            }
            if (!$found) {
                if (getprotobyname($port)) {
                    push(@open_port, [undef, $port, $from, $to]);
                } else {
                    warn "ambiguous allow '$port', ignoring...\n";
                    next;
                }
            }
        } else {
            if ($port!~/^\d+$/ and !getservbyname($port, $proto)) {
                warn "invalid port/proto '$port/$proto', ignoring...\n";
                next;
            }

            push(@open_port, [$port, $proto, $from, $to]);
        }
    }

    for my $port (@open_port) {
        debug "allowing proto ", $port->[1],
              defined($port->[0]) ?
                  ", port " . $port->[0] : "",
              defined($port->[2]) ?
                  ", from " . $port->[2] : "",
              defined($port->[3]) ?
                  ", to " . $port->[3] : "";
        allow($in, $out, @{$port});
    }
}

sub allow {
    my ($in, $out, $port, $proto, $from, $to)=@_;

    rule label($in) . "-" . label($out),
             "-p", $proto, $port ? ("--dport", $port) : (),
             $from ? ("-s", $from) : (), $to ? ("-d", $to) : (),
             qw(-j acceptnew);
}

sub label {
    my ($name)=@_;

    my $label=$interface{$name}->{'flags'}->{'label'};

    return (defined($label) and length($label)) ? $label : $name;
}

sub generate_rules {
    my %interface=@_;

    # Check chain name lengths.  Error out if they're too long.
    for my $in (keys(%interface)) {
        next if (exists($interface{$in}->{'flags'}->{'ignore'}));

        for my $out (keys(%interface)) {
            next if ($in eq $out
                     or exists($interface{$out}->{'flags'}->{'ignore'}));

            my $maxlength=30;

            my $name=label($in) . "-" . label($out);

            if (length($name) > $maxlength) {
                die "Chain name '$name' is more than $maxlength characters.\n"
                    . "Invalid configuration detected.  Exiting!\n";
            }
        }
    }

    # Build NAT (POSTROUTING) rules.
    for my $in (keys(%interface)) {
        next if (exists($interface{$in}->{'flags'}->{'ignore'}));

        debug "checking interface $in";
        if (exists($interface{$in}->{'flags'}->{'nat'})) {
            debug "need to nat interface $in";
            for my $out (keys(%interface)) {
                next if ($in eq $out or
                         $interface{$out}->{'type'} ne "out" or
                         exists($interface{$out}->{'flags'}->{'ignore'}));

                debug "found interface $out to nat out";

                for my $iface ($in, $out) {
                    if (!defined($interface{$iface}->{'cfg'})
                        or !@{$interface{$iface}->{'cfg'}}) {
                        debug "I have no configuration for interface $iface!\n";
                        # FIXME: "nat" on undefined interface breaks everything.
                        # Expected on the early boot pass with the "ip"
                        # address source, when nothing has an address yet;
                        # genfw-online.service runs again once it does.
                        warn "No addresses known for interface $iface "
                           . "(not configured, or not up yet); skipping NAT "
                           . "involving it this run.\n";
                        next;
                    }
                }

                # I can't see where there is any point to this warning.
                #if (@{$interface{$out}->{'cfg'}}>1)
                #{
                #    warn "interface $out has multiple configurations, " .
                #        "using first address found.\n";
                #}

                for my $cfg (@{$interface{$in}->{'cfg'}}) {
                    # *FIXME* - need to handle aliased interfaces on the same
                    # subnet correctly (without adding additional rules)
                    # *FIXME* - This also isn't going to work if the *inside*
                    # interface is dynamically assigned, although that just
                    # wouldn't usually make a hell of a lot of sense...
                    my @rule=("-o", $out, "-s",
                              $cfg->{'network'} . "/" . $cfg->{'netmask'});
                    if (defined($interface{$out}->{'cfg'}->[0]->{'ipaddr'})) {
                        unshift(@{$conf{'append'}->{'nat:POSTROUTING'}},
                            [@rule, qw(-j SNAT --to),
                             $interface{$out}->{'cfg'}->[0]->{'ipaddr'}]);
                    } else {
                        unshift(@{$conf{'append'}->{'nat:POSTROUTING'}},
                            [@rule, qw(-j MASQUERADE)]);
                    }
                }
            }
        }
    }

    # Build NAT (PREROUTING) rules.
    for my $in (keys(%interface)) {
        debug "PREROUTING: checking $in...";
        next if ($interface{$in}->{'type'} ne "out" or
                 exists($interface{$in}->{'flags'}->{'ignore'}));

        for my $out (keys(%interface)) {
            debug "PREROUTING:   checking $out -> $in...";
            next if ($in eq $out or $interface{$out}->{'type'} eq "out" or
                     exists($interface{$out}->{'flags'}->{'ignore'}) or
                     !exists($interface{$out}->{'flags'}->{'nat'}));

            debug "filtering traffic to $out from $in...";

            for my $cfg (@{$interface{$out}->{'cfg'}}) {
                # *FIXME* - need to handle aliased interfaces on the same
                # subnet correctly (without adding additional rules)
                my @rule=("-i", $in, "-d",
                          $cfg->{'network'} . "/" . $cfg->{'netmask'});
                unshift(@{$conf{'append'}->{'mangle:PREROUTING'}},
                    [@rule, qw(-j DROP)]);
                unshift(@{$conf{'append'}->{'mangle:PREROUTING'}},
                    [@rule, @{$conf{'log'}}, "--log-prefix",
                        sprintf("%.29s",
                            label($in) . " -> " . label($out) . ": bad dest: ")])
                    if (@{$conf{'log'}});
            }
        }
    }

    # Set default actions for our built-in chains.
    unshift(@{$conf{'append'}->{'acceptnew'}},
            [qw(-m state --state NEW -j ACCEPT)]);
    unshift(@{$conf{'append'}->{'established'}},
            [qw(-m state --state), "ESTABLISHED,RELATED", qw(-j ACCEPT)]);
    unshift(@{$conf{'append'}->{'icmp-filter'}}, [qw(-p icmp -j acceptnew)]);

    # Set default actions for iptables built-in chains.
    # INPUT
    my @input_rules_early=(
            [qw(-j established)], # Allow established (and related) connections.
            [qw(-i lo -j ACCEPT)], # Allow traffic to localhost.
        );

    for my $iface (keys(%interface)) {
        next if (exists($interface{$iface}->{'flags'}->{'ignore'}));

        if (($interface{$iface}->{'type'} eq "int") &&
            exists($interface{$iface}->{'flags'}->{'trusted'})) {
            push(@input_rules_early, ["-i", $iface, "-j", "ACCEPT"]);
        }
    }

    unshift(@{$conf{'append'}->{'INPUT'}}, @input_rules_early);

    my @input_rules_late=(
            [qw(-p tcp --dport 113 -j REJECT --reject-with tcp-reset)], # ident
            [qw(-p udp --dport 113 -j REJECT),
             qw(--reject-with icmp-port-unreachable)], # ident
            [qw(-j icmp-filter)], # ICMP
        );

    push(@input_rules_late,
        [@{$conf{'log'}}, "--log-prefix", "INPUT fall-through: "])
        if (@{$conf{'log'}} and $conf{'policy'}->{'INPUT'} eq "DROP");

    push(@{$conf{'append'}->{'INPUT'}}, @input_rules_late);

    # OUTPUT
    my @output_rules_early=(
            [qw(-j established)], # Allow established (and related) connections.
        );

    unshift(@{$conf{'append'}->{'OUTPUT'}}, @output_rules_early);

    my @output_rules_late=(
            [qw(-j icmp-filter)], # ICMP
        );

    push(@output_rules_late,
        [@{$conf{'log'}}, "--log-prefix", "OUTPUT fall-through: "])
        if (@{$conf{'log'}} and $conf{'policy'}->{'OUTPUT'} eq "DROP");

    push(@{$conf{'append'}->{'OUTPUT'}}, @output_rules_late);

    # FORWARD
    my @forward_rules_early=(
           #[qw(-j established)], # Allow established (and related) connections.
        );

    for my $in (keys(%interface)) {
        next if (exists($interface{$in}->{'flags'}->{'ignore'}));

        push(@forward_rules_early, ["-i", $in, "-j", label($in)]);
    }

    unshift(@{$conf{'append'}->{'FORWARD'}}, @forward_rules_early);

    my @forward_rules_late=(
        );

    push(@forward_rules_late,
        [@{$conf{'log'}}, "--log-prefix", "FORWARD fall-through: "])
        if (@{$conf{'log'}} and $conf{'policy'}->{'FORWARD'} eq "DROP");

    push(@{$conf{'append'}->{'FORWARD'}}, @forward_rules_late);
    
    # Record the ruleset. Loading a table with iptables-restore replaces it,
    # so there is no explicit flush step any more.
    set_policy($conf{'policy'});

    comment_block "genfw-defined chains.";

    for my $chain (@{$conf{'genfw_chains'}}) {
        if (length($conf{'chain'}->{$chain})) {
            comment_long $conf{'chain'}->{$chain};
        } else {
            comment_long $chain;
        }
        chain($chain);
        insert($chain);
        append($chain);
    }

    comment_block "User-defined chains.";

    if (defined($conf{'chain'})) {
        for my $chain (@{$conf{'chains'}}) {
            if (length($conf{'chain'}->{$chain})) {
                comment_long $conf{'chain'}->{$chain};
            } else {
                comment_long $chain;
            }
            chain($chain);
            insert($chain);
            append($chain);
        }
    }

    for my $in (keys(%interface)) {
        next if (exists($interface{$in}->{'flags'}->{'ignore'}));

        for my $out (keys(%interface)) {
            next if ($in eq $out or
                     exists($interface{$out}->{'flags'}->{'ignore'}));

            my $label=label($in) . "-" . label($out);

            comment_block(label($in) . " -> " . label($out));
            chain($label);
            debug "insert($label)";
            insert($label);
            if ($interface{$in}->{'type'} eq "out" and
                $interface{$out}->{'type'} eq "out") {
                drop($in, $out);
            } else {
                # Filter traffic to the network address.
                filter_to($in, $out, "network");
                # Filter traffic to the broadcast address.
                filter_to($in, $out, "broadcast");

                if (($interface{$in}->{'type'} eq "int" and
                     exists($interface{$in}->{'flags'}->{'trusted'})) or
                    ($interface{$in}->{'type'} eq "dmz" and
                     $interface{$out}->{'type'} eq "out" and
                     exists($interface{$in}->{'flags'}->{'trusted'}))) {
                    debug "append($label)";
                    append($label);
                    established($in, $out);
                    acceptnew($in, $out);
                } else {
                    check_allowed($in, $out);
                    debug "append($label)";
                    append($label);
                    established($in, $out);
                    icmpfilter($in, $out);
                    reject_auth($in, $out);
                    drop($in, $out);
                }
            }
        }
    }

    for my $in (keys(%interface)) {
        next if (exists($interface{$in}->{'flags'}->{'ignore'}));

        comment_block("Filter traffic from " . label($in) . ".");
        chain(label($in));

        debug "insert(" . label($in) . ")";
        insert(label($in));

        # *FIXME* - need to handle aliased interfaces on the same
        # subnet correctly (without adding additional rules)
        filter_from($in, "network");
        filter_from($in, "broadcast");

        for my $out (keys(%interface)) {
            next if (exists($interface{$out}->{'flags'}->{'ignore'}));

            if ($in eq $out) {
                comment "Allow connections originating from this interface.";
                rule(label($in), "-o", $out, "-j", "ACCEPT");
            } else {
                rule(label($in), "-o", $out, "-j",
                     label($in) . "-" . label($out));
            }
        }

        debug "append(" . label($in) . ")";
        append(label($in));
    }

    for my $table_chain (
            map(["filter", $_], qw(INPUT OUTPUT FORWARD)),
            map(["nat", $_], qw(POSTROUTING PREROUTING OUTPUT)),
            map(["mangle", $_],
                qw(PREROUTING OUTPUT INPUT FORWARD POSTROUTING)),
            map(["raw", $_], qw(PREROUTING OUTPUT))) {
        my $label=$table_chain->[0] eq "filter"
            ? $table_chain->[1] : ($table_chain->[0] . ":" . $table_chain->[1]);

        next unless ((defined($conf{'insert'})
                and defined($conf{'insert'}->{$label}))
            or (defined($conf{'append'})
                and defined($conf{'append'}->{$label})));

        comment_block
            $table_chain->[1] . " chain (" . $table_chain->[0] . " table)";
        debug "insert($label)";
        insert($label);
        debug "append($label)";
        append($label);
    }
}

sub icmpfilter {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out), qw(-j icmp-filter);
}

sub established {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out), qw(-j established);
}

sub drop {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out), @{$conf{'log'}},
          "--log-prefix", sprintf("%.29s",
              label($in) . " -> " . label($out) . ": ")
        if (@{$conf{'log'}});
    rule label($in) . "-" . label($out), qw(-j DROP);
}

sub accept {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out), qw(-j ACCEPT);
}

sub acceptnew {
    my ($in, $out)=@_;

    rule label($in) . "-" . label($out), qw(-j acceptnew);
}

sub filter_from {
    my ($in, $item)=@_;

    debug "$in, filtering from $item";

    if (!defined($interface{$in}->{'cfg'}) or !@{$interface{$in}->{'cfg'}}) {
        debug "I have no configuration for interface $in!\n";
        return;
    }

    comment "Filter traffic from the $item address(es).";

    for my $cfg (@{$interface{$in}->{'cfg'}}) {
        # Skip this on dynamic interfaces.
        next if (!defined($cfg->{'ipaddr'}));

        if ($cfg->{$item} eq $cfg->{'ipaddr'}) {
            comment "Skipping point-to-point address " . $cfg->{'ipaddr'} . ".";
            next;
        }
        my @rule=(label($in), "-d", $cfg->{$item});
        rule @rule, @{$conf{'log'}}, "--log-prefix",
             sprintf("%.29s", label($in) . ": $item: ")
            if (@{$conf{'log'}});
        rule @rule, qw(-j DROP);
    }
}

sub filter_to {
    my ($in, $out, $item)=@_;

    debug "$in -> $out, filtering to $item";

    if (!defined($interface{$out}->{'cfg'}) or !@{$interface{$out}->{'cfg'}}) {
        debug "I have no configuration for interface $out!\n";
        return;
    }

    comment "Filter traffic to the $item address(es).";

    for my $cfg (@{$interface{$out}->{'cfg'}}) {
        # Skip this on dynamic interfaces.
        next if (!defined($cfg->{'ipaddr'}));

        if ($cfg->{$item} eq $cfg->{'ipaddr'}) {
            comment "Skipping point-to-point address " . $cfg->{'ipaddr'} . ".";
            next;
        }
        my @rule=(label($in) . "-" . label($out), "-d", $cfg->{$item});
        rule @rule, @{$conf{'log'}}, "--log-prefix",
             sprintf("%.29s",
                 label($in) . "-" . label($out) . ": $item: ")
            if (@{$conf{'log'}});
        rule @rule, qw(-j DROP);
    }
}

sub parserules {
    my $file=shift;

    my $fh=new FileHandle $file, "r"
        or die "Couldn't open $file: $!\n";

    debug "Parsing file '$file'...";

    # *FIXME* - need to handle when the last line ends in '\'
    my $last;
    while (<$fh>) {
        chomp;
        s/(?<!\\)#.*$//; # Strip comments ("\" escapes "#")
        s/\\#/#/g;
        $_=$last.$_ if ($last);
        if (s/\\\s*$//) {
            $last=$_;
            next;
        } else {
            $last="";
        }
        next if (/^\s*$/); # Skip blank lines

        debug "$_";
        my @parts=split;
        if ($parts[0]=~/^(dmz)$/ or
            $parts[0]=~/^(int)(?:ernal)?$/ or
            $parts[0]=~/^(out)(?:put|side)?$/) {
            my $type=$1;
            shift @parts;
            my $name=shift(@parts);
            if (!$name) {
                warn "No interface defined:\n\t$_\nSkipping...\n";
                next;
            }
            debug "Interface $name, type $type found.";
            if (defined($interface{$name})) {
                warn "Skipping duplicate definition for interface $name:\n\t$_\n";
                next;
            }
            $interface{$name}={'type' => $type, 'flags' => {}};
            my $flags=$interface{$name}->{'flags'};
            for my $part (@parts) {
                my ($key, $value)=split(/=/, $part, 2);
                if ($key=~/^(?:ignore|trusted|nat)$/ and !defined($value)) {
                    $flags->{$key}=1;
                    debug "interface $name flag $key";
                } elsif ($key eq "label" and defined($value)) {
                    if (exists($flags->{'label'})) {
                        warn "Ignoring duplicate label '$value' on interface "
                           . "$name (using '$flags->{'label'}').\n";
                        next;
                    }
                    $flags->{'label'}=$value;
                    debug "interface $name flag label=$value";
                } elsif ($key eq "allow" and defined($value)) {
                    # Parsed here; check_allowed() does the service and
                    # protocol lookups when rules are generated.
                    for my $ports (split /,/, $value) {
                        # *FIXME* - probably should verify that source
                        # & destination are valid-looking addresses
                        my %allow;
                        @allow{qw(port proto from to interface)}=
                            $ports=~/^(.*?)           # port (or protocol)
                                      (?:\/(.*?))?    # protocol (can be omitted)
                                      (?::(.*?))?     # source address (ditto)
                                      (?::(.*?))?     # destination address (ditto)
                                      (?::(.*?))?     # source interface
                                     $/x;
                        push(@{$flags->{'allow'}}, \%allow);
                        debug "interface $name flag allow: "
                            . join(", ", map { defined($allow{$_}) ? "$_=$allow{$_}" : () }
                                             qw(port proto from to interface));
                    }
                } else {
                    warn "Ignoring unsupported flag '$part' on interface $name.\n";
                }
            }
        } elsif (defined($parts[1]) and ($parts[1] eq "logging")) {
            if ($parts[0] eq "no") {
                $conf{'log'}=[];
            } elsif ($parts[0] eq "limit") {
                $conf{'log'}=[qw(-m limit -j LOG)];
            } elsif ($parts[0] eq "full") {
                $conf{'log'}=[qw(-j LOG)];
            } else {
                warn "I don't know what you mean by '@parts[0,1]' (line $.).\n";
                next;
            }
        } elsif ($parts[0]=~/^(append|insert)$/
               and defined($parts[1]) and defined($parts[2])) {
            # This is a totally bogus test.
            #if ($parts[1]!~
            #       /^((filter:)?(INPUT|OUTPUT|FORWARD)|nat:(PRE|POST)ROUTING)$/)
            #{
            #    warn "Ignoring $parts[0] on unknown chain $parts[1] "
            #       . "(rules line $.).\n";
            #    next;
            #}
            # "filter" is the default table, so "filter:INPUT" and "INPUT"
            # must refer to the same chain.
            $parts[1]=~s/^filter://;
            push(@{$conf{$parts[0]}->{$parts[1]}}, [@parts[2..$#parts]]);
        } elsif ($parts[0] eq "chain" and defined($parts[1])) {
            $parts[1]=~s/^filter://;
            if ($conf{$parts[0]}
                and grep { $parts[1] eq $_ } keys(%{$conf{$parts[0]}})) {
                warn "Not re-declaring chain '$parts[1]'!\n";
                next;
            }

            if (@parts>2) {
                $conf{$parts[0]}->{$parts[1]}="@parts[2 .. $#parts]";
            } else {
                $conf{$parts[0]}->{$parts[1]}="";
            }
            push(@{$conf{'chains'}}, $parts[1]);
        } elsif ($parts[0] eq "include" and defined($parts[1])) {
            for my $rule_file (glob(substr($parts[1], 0, 1) eq "/"
                                    ? $parts[1]
                                    : "$config_dir/$parts[1]")) {
                parserules($rule_file) if (-e $rule_file);
            }
        } elsif ($parts[0] eq "addresses" and defined($parts[1])) {
            if ($parts[1]=~/^(ifcfg|ip)$/) {
                $conf{'addresses'}=$1;
            } else {
                warn "Unknown address source '$parts[1]' (line $.); "
                   . "expected 'ifcfg' or 'ip'.\n";
            }
        } elsif ($parts[0] eq "policy" and scalar(@parts) == 3) {
            $parts[1]=~s/^filter://;
            warn "Bad $parts[1] policy target '$parts[2]'\n"
                unless ($parts[2] =~ /^(ACCEPT|DROP|QUEUE|RETURN)$/);
            $conf{$parts[0]}->{$parts[1]}=$parts[2];
        } else {
            warn "Skipping bogus line ($.):\n\t$_\n";
            next;
        }
        debug;
    }
}

# The first of @candidates that exists, warning if more than one does since
# only one is read. Falls back to the first candidate when none exist, so
# the "no rules found" error names the canonical location.
sub default_config_dir {
    my @candidates=@_;
    my @found=grep { -d $_ } @candidates;

    return $candidates[0] unless (@found);
    warn "Using configuration in $found[0]; ignoring @found[1..$#found].\n"
        if (@found > 1);
    return $found[0];
}

# Addresses for interface $name from network-scripts/ifcfg-$name and any
# ifcfg-$name:N aliases. Returns a list of config hashes (see parseconfig).
sub ifcfg_addresses {
    my ($name)=@_;

    my $dir=new DirHandle "$sysconfig_dir/network-scripts"
        or die "Failed to open $sysconfig_dir/network-scripts: $!\n";
    my @configs=("$sysconfig_dir/network-scripts/ifcfg-$name");
    for my $file (grep(/^ifcfg-\Q$name\E:\d+$/, $dir->read)) {
        push(@configs, "$sysconfig_dir/network-scripts/$file");
    }

    my @cfgs;
    for my $configfile (@configs) {
        debug "configfile: $configfile";
        my %cfg=parseconfig($configfile, $name);
        push(@cfgs, \%cfg) if (%cfg);
    }
    return @cfgs;
}

# Addresses for interface $name from the running system, via
# "ip -o -4 addr show dev $name". The one-line format is the same on every
# iproute2 version genfw runs on (EL7's predates JSON output) and needs no
# modules to parse. Each address becomes one config hash, like one ifcfg
# file. An address flagged "dynamic" (assigned by DHCP) is treated like
# BOOTPROTO=dhcp: the interface is known, but its address is not relied on,
# since it can change while the generated rules stay in place.
sub ip_addresses {
    my ($name)=@_;

    my $pid=open(my $fh, '-|');
    die "Can't fork to run ip: $!\n" unless (defined($pid));
    if (!$pid) {
        open(STDERR, '>', '/dev/null');
        exec('ip', '-o', '-4', 'addr', 'show', 'dev', $name) or exit(127);
    }
    my @lines=<$fh>;
    close($fh);
    my $status=$? >> 8;

    if ($status == 127) {
        warn "The ip command was not found; can't determine addresses "
           . "for interface $name.\n";
        return;
    }
    if ($status != 0) {
        debug "ip found no device $name (exit $status)";
        return;
    }

    my @cfgs;
    for my $line (@lines) {
        chomp($line);
        my ($ipaddr, $prefix, $brd, $rest)=
            $line=~/^\d+:\s+\S+\s+inet\s+(\d+\.\d+\.\d+\.\d+)\/(\d+)
                     (?:\s+brd\s+(\S+))?\s*(.*)$/x;
        if (!defined($ipaddr)) {
            debug "Skipping unexpected ip output for $name: $line";
            next;
        }
        debug "ip: $name $ipaddr/$prefix" . (defined($brd) ? " brd $brd" : "");

        if ($rest=~/\bdynamic\b/) {
            debug "  dynamic address; not relying on it";
            push(@cfgs, {'bootproto' => 'dhcp'});
            next;
        }

        my $netmask=prefix_to_netmask($prefix);
        my $network=inet_ntoa(inet_aton($ipaddr) & inet_aton($netmask));
        my $broadcast=defined($brd) ? $brd
                    : inet_ntoa(inet_aton($ipaddr) | ~inet_aton($netmask));
        push(@cfgs, {'ipaddr' => $ipaddr, 'netmask' => $netmask,
                     'network' => $network, 'broadcast' => $broadcast,
                     'bootproto' => 'static'});
    }
    return @cfgs;
}

sub prefix_to_netmask {
    my ($prefix)=@_;

    my $bits=$prefix == 0 ? 0 : ((0xFFFFFFFF << (32 - $prefix)) & 0xFFFFFFFF);
    return inet_ntoa(pack('N', $bits));
}

sub parseconfig {
    my ($configfile, $name)=@_;
    my %cfg;

    if (my $config=new FileHandle "<$configfile") {
        while (<$config>) {
            chomp;
            s/(?<!\\)#.*$//; # Strip comments ("\" escapes "#")
            s/\\#/#/g;
            next if (/^\s*$/); # Skip blank lines

            debug $_;
            if (/^\s*(\S+)\s*=\s*"?(\S+?)"?\s*$/) {
                my ($var, $value)=($1, $2);

                if ($var eq "DEVICE") {
                    warn "$configfile says DEVICE is $value not $name!\n"
                        if ($value!~/^$name(?::\d+)?$/);
                } elsif ($var=~/^(?:IPADDR|NETMASK|NETWORK|BROADCAST|BOOTPROTO)$/) {
                    warn "$name " . lc($var)
                       . " redefined, $configfile line $.\n"
                        if (defined($cfg{lc($var)}));
                    $cfg{lc($var)}=$value;
                } else {
                    debug "Skipping uninteresting variable $var...";
                }
            } else {
                debug "Skipping strange configuration line:\n\t$_\n"
                   . "$configfile line $.\n";
                next;
            }
        }
    } else {
        debug "Couldn't open $configfile: $!\n";
    }

    if (%cfg) {
        if (!exists($cfg{'bootproto'}) or !defined($cfg{'bootproto'})
            or $cfg{'bootproto'} eq 'none' or $cfg{'bootproto'} eq 'static') {
            my $network=inet_ntoa(inet_aton($cfg{'ipaddr'})
                                  & inet_aton($cfg{'netmask'}));
            my $broadcast=inet_ntoa(inet_aton($cfg{'ipaddr'})
                                    | (~ inet_aton($cfg{'netmask'})));

            debug "Calculated network $network, broadcast $broadcast";

            if (!defined($cfg{'network'}) or $network ne $cfg{'network'}) {
                warn "$configfile has incorrect network address $cfg{'network'}\n"
                    if (defined($cfg{'network'}));
                $cfg{'network'}=$network;
            }

            if (!defined($cfg{'broadcast'}) or $broadcast ne $cfg{'broadcast'}) {
                warn "$configfile has incorrect broadcast address $cfg{'broadcast'}\n"
                    if (defined($cfg{'broadcast'}));
                $cfg{'broadcast'}=$broadcast;
            }
        }
    }

    return %cfg;
}

sub debug {
    return unless (defined($ENV{'DEBUG'}) || $opt{'d'});
    if (!@_) {
        print STDERR "\n";
    } else {
        #print STDERR "\033[37;1md:\033[0m ", @_, "\n";
        print STDERR bold("d: "), @_, "\n";
    }
}

sub bold {
    # IO::Interactive is not a core module, so keep the plain -t test.
    return @_ if (!-t STDERR); ## no critic (InputOutput::ProhibitInteractiveTest)
    return "\033[37;1m" . $_[0] . "\033[0m";
}

sub comment_block {
    push(@pending_comments, "", "####", "#");
    comment(@_);
    push(@pending_comments, "#");
}

sub comment_long {
    push(@pending_comments, "", "#");
    comment(@_);
    push(@pending_comments, "#");
}

# Comments attach to the next rule recorded, in whatever table it lands in.
sub comment {
    push(@pending_comments, map("# $_", @_));
}

sub set_policy {
    my $policy=shift;

    for my $label (keys %{$policy}) {
        policy($label, $policy->{$label});
    }
}

# "[table:]chain" -> (table, chain), defaulting to the filter table.
sub split_label {
    my ($label)=@_;

    return ($label=~/^([^:]+):(.+)$/) ? ($1, $2) : ('filter', $label);
}

sub table {
    my ($table)=@_;

    warn "Unknown table '$table'.\n" unless (grep { $_ eq $table } @tables);
    $ruleset{$table}||={'chains' => [], 'policy' => {}, 'rules' => []};
    return $ruleset{$table};
}

sub chain {
    my ($label)=@_;
    my ($table, $chain)=split_label($label);

    debug "new chain $chain, table '$table'";
    push(@{table($table)->{'chains'}}, $chain);
}

sub policy {
    my ($label, $target)=@_;
    my ($table, $chain)=split_label($label);

    debug "policy $target for chain $chain, table '$table'";
    table($table)->{'policy'}->{$chain}=$target;
}

# Record one rule, appended to chain "[table:]chain", with iptables-style
# arguments. Every rule the firewall contains goes through here.
sub rule {
    my ($label, @args)=@_;
    my ($table, $chain)=split_label($label);

    debug "rule in $chain, table '$table': @args";
    push(@{table($table)->{'rules'}},
         {'chain' => $chain, 'args' => [@args],
          'comments' => [@pending_comments]});
    @pending_comments=();
}

sub insert {
    action('insert', $_[0]);
}

sub append {
    action('append', $_[0]);
}

sub action {
    my ($action, $label)=@_;

    debug "$action in $label";

    if (defined($conf{$action}) and defined($conf{$action}->{$label})) {
        my @rules=@{$conf{$action}->{$label}};
        @rules=reverse @rules if ($action eq 'insert');
        for my $rule (@rules) {
            debug "Adding rule '@{$rule}'...";
            rule $label, @{$rule};
        }
    }
}

####
#
# Output backends
#

# iptables-restore(8) input. Every table is listed, even when empty, so that
# loading the file replaces the whole firewall: iptables-restore flushes a
# table it is given, and leaves alone any table it is not.
#
# The "#!" line lets a saved copy be executed directly: the kernel runs
# iptables-restore with the file as its argument, and the loader skips the
# line as a comment. /usr/sbin is where every supported platform keeps it.
sub format_iptables_restore {
    my ($rs)=@_;

    my $text="#!/usr/sbin/iptables-restore\n"
           . "# Generated by genfw $VERSION\n"
           . "# Load with \"iptables-restore < this-file\", or make this file\n"
           . "# executable and run it.\n";

    for my $table (@tables) {
        my $t=$rs->{$table} || {'chains' => [], 'policy' => {}, 'rules' => []};

        $text.="\n*$table\n";

        for my $chain (@{$builtin{$table}}) {
            $text.=":$chain $t->{'policy'}->{$chain} [0:0]\n"
                if (defined($t->{'policy'}->{$chain}));
        }
        for my $chain (@{$t->{'chains'}}) {
            # A policy on a user chain is an error, but let iptables-restore
            # report it rather than silently dropping what the user wrote.
            my $policy=defined($t->{'policy'}->{$chain})
                ? $t->{'policy'}->{$chain} : "-";
            $text.=":$chain $policy [0:0]\n";
        }
        for my $rule (@{$t->{'rules'}}) {
            $text.=join("", map("$_\n", @{$rule->{'comments'}}));
            $text.=join(" ", "-A", $rule->{'chain'},
                        map(quote_restore($_), @{$rule->{'args'}})) . "\n";
        }

        $text.="COMMIT\n";
    }

    if (@pending_comments) {
        debug "Dropping trailing comments with no rule to attach to.";
        @pending_comments=();
    }

    return $text;
}

# iptables-restore splits on whitespace and understands double-quoted
# arguments with backslash escapes for '"' and '\'. Quote anything outside
# a conservative safe set.
sub quote_restore {
    my ($arg)=@_;

    return $arg if ($arg=~/^[\w.\/:,!+=@%-]+$/);
    $arg=~s/([\\"])/\\$1/g;
    return "\"$arg\"";
}

# Feed the formatted ruleset to a backend command (the loader, or its test
# mode). A failure here means the firewall was not (or not fully) updated,
# so it is fatal.
sub apply_ruleset {
    my ($text, @command)=@_;

    debug "Running '@command'...";

    open(my $pipe, '|-', @command)
        or die "Failed to run '@command': $!\n";
    print $pipe $text;
    if (!close($pipe)) {
        die "'@command' failed with exit value " . ($? >> 8) . "\n" if ($?);
        die "Failed writing to '@command': $!\n";
    }
}

__END__

=head1 NAME

genfw - Generate an iptables firewall from a simple rules file

=head1 SYNOPSIS

B<genfw> [B<-d>] [B<-i>]

=head1 DESCRIPTION

genfw generates a complete iptables ruleset from a F<rules> file describing
the system's interfaces and the network configuration of the system. The
output is in the format read by L<iptables-restore(8)>: every table is
listed, so loading it replaces the whole firewall in one step.

By default the ruleset is printed to standard output, where it can be
reviewed, saved, or loaded with C<iptables-restore>. It begins with a
C<#!/usr/sbin/iptables-restore> line, so a saved copy made executable can
also be run directly to load itself. With B<-i> it is loaded directly.

=head1 COMMAND-LINE OPTIONS

=over 4

=item B<-c> I<directory>

Read F<rules> and F<rules.d/*.rules> from I<directory> instead of the
default location (see L</FILES>). Relative C<include> paths are resolved
against it too.

=item B<-i>

Install the ruleset: pipe it to C<iptables-restore> instead of printing it.
The ruleset is first checked with C<iptables-restore --test>, so a ruleset
that cannot be parsed is rejected before anything is changed; only then is
it loaded. A failure at either step is fatal, since it means the firewall
was not (or not fully) updated. This is what the systemd units run.

=item B<-d>

Debug mode. Read F<genfw/rules>, F<genfw/rules.d/*.rules>, and
F<network-scripts/ifcfg-*> from the current directory instead of F</etc>,
and print tracing to standard error. Setting the
C<DEBUG> environment variable has the same effect and also dumps the parsed
interface table. Useful for trying a configuration without root and
without touching the live firewall.

=back

=head1 CONFIGURATION

The F<rules> file should contain one line for each interface on the system.
Like most standard Unix configuration files, C<\> is used to continue lines
and C<#> is used to begin comments.

=head2 Directives

=over 4

=item C<internal> I<interface>

An "internal" interface tends to be able to connect out, but nothing can
connect in to it.

=item C<int> I<interface>

Equivalent to C<internal>.

=item C<dmz> I<interface>

A "dmz" interface tends allow connections from the outside world, but can't
connect to "internal" interfaces, and can sometimes connect out to the
world.

=item C<outside> I<interface>

An "outside" interface usually can't connect to "internal" interfaces but
can connect to some things on "dmz" interfaces.  Also, traffic is not
allowed between "outside" interfaces.

=item C<output> I<interface>

Equivalent to C<outside>.

=item C<out> I<interface>

Equivalent to C<outside>.

=item C<append> [I<table>:]I<chain> I<rule>

This appends I<rule> to a I<chain> in a specified I<table>.  If I<table>
(and the colon (:) after it) is omitted, the filter table is assumed.

For example, the following would redirect outgoing connections on port 80
to port 3128 (for transparent proxying with squid):

 append nat:PREROUTING -i eth0 -p tcp --dport 80 -j REDIRECT --to 3128

=item C<insert> [I<table>:]I<chain> I<rule>

This inserts I<rule> at the beginning of I<chain> in a specified I<table>.
See L</append> above.

=item C<chain> [I<table>:]I<name> [I<comment>]

This creates a chain named I<name> in the specified I<table> (for use with
C<append> and C<insert>).

=item C<policy> [I<table>:]I<name> I<target>

Set the policy for the chain I<name> (I<table> table) to I<target>.

=item C<no logging>

Modifies generated rules so that dropped packets are not logged.

=item C<limit logging>

Dropped packets are logged, but rate-limited.  This adds C<-m limit> to all
C<-j LOG> lines.  This is the default.

=item C<full logging>

Modifies generated rules so that all dropped packets are logged.

=item C<include> I<file>

Includes rules from I<file>, which may be a glob.

=item C<addresses> C<ifcfg>|C<ip>

Where to learn each interface's addresses. C<ifcfg> reads the Red Hat
F<network-scripts/ifcfg-*> files, including C<ifcfg-eth0:1> style aliases.
C<ip> asks the running system with C<ip -o -4 addr show>, which works on any
Linux distribution but requires the interfaces to be configured when genfw
runs; an address that C<ip> reports as C<dynamic> (assigned by DHCP) is
treated the same as C<BOOTPROTO=dhcp>. The default is C<ifcfg> when any
F<ifcfg-*> file exists and C<ip> otherwise.

When relying on C<ip>, make sure genfw runs after the network is up, for
example by ordering the systemd unit after C<network-online.target>, or by
re-running C<genfw -i> from a network dispatcher hook.

=back

=head2 Flags

Any of the interface definition lines can include any number of the
following whitespace-separated options:

=over 4

=item C<ignore>

Don't generate rules for this interface.

=item C<allow=>I<port>C</>I<proto>[C<:>I<src>[C<:>I<dest>[C<:>I<interface>]]]>[C<,>...]

Allow specific traffic to this interface.  This option can take many
including any of the following:

=over 8

=item C<allow=>I<port>

Checks for I<port>/tcp and I<port>/udp in F</etc/services>.  Rules are
generated for each one that is defined.  An example might be
C<allow=domain> to allow traffic to UDP or TCP port 53.

=item C<allow=>I<protocol>

Checks for I<protocol> in F</etc/protocols>.  A rule is generated if the
protocol is defined.  For example, C<allow=gre>.

=item C<allow=>I<port>C</>I<protocol>

Allows traffic to the specified I<port> on the specified I<protocol>.
I<port> can be numeric.  (I<protocol> may also be numeric, although this is
untested at the moment.)  Examples might be C<allow=smtp/tcp> or
C<allow=25/tcp>.  Both are equivalent.

=back

Any number of protocols, ports, etc. can be included after an C<allow=> in
a comma-separated list.

Any of the above can also be followed by a colon-separated list including
the source address, destination address, and source interface.  Any of the
three can be left blank.

For example, C<allow=ssh/tcp:::eth0> would allow ssh access from eth0, but
nowhere else.

=item C<label=>I<label>

Use I<label> in the names of chains, log messages, etc. instead of the
interface name.

=item C<trusted>

Only used for "dmz" and "internal" interfaces.  Any "trusted" interface is
allowed full outgoing network access.  Also, "internal" networks that are
"trusted" can connect to anything on a "dmz" network.

=item C<nat>

Do Network Address Translation on packets going out from this interface.
This only applies to traffic from an "internal" or "dmz" interface to an
"outside" interface.

=back

=head1 FILES

F</etc/genfw/rules>   The rules used to generate the firewall.

F</etc/genfw/rules.d/*.rules>   Additional rules used to generate the firewall.

F</etc/sysconfig/genfw/>   The historical location of the above. It is used
when F</etc/genfw> does not exist; if both exist, F</etc/genfw> wins and a
warning is printed. The RPM still creates this directory. Support for it
will be removed in a future major version.

F</etc/sysconfig/network-scripts/ifcfg-*> The network configuration, when
using the C<ifcfg> address source.

=head1 SYSTEMD INTEGRATION

Two units are installed. C<genfw.service> runs C<genfw -i> before any
interface is configured (C<Before=network-pre.target>), so no traffic is
ever handled without a firewall, and pulls in C<genfw-online.service>, which
runs it again after C<network-online.target>. With the C<ifcfg> address
source the first pass is already complete and the second is a harmless
repeat. With the C<ip> source the first pass lacks whatever depends on
addresses (network and broadcast filtering, NAT) because nothing has an
address yet, and the second pass adds it. Only the first needs enabling:

    systemctl enable --now genfw.service

Upgrading the package reloads systemd and restarts C<genfw.service>, so the
rules are regenerated with the new version.

Interfaces that appear after boot (a VPN, a hotplugged device) are covered
by hooks that run C<systemctl try-restart genfw.service> when an interface
comes up: one for NetworkManager (F<dispatcher.d>), one for
networkd-dispatcher (F<routable.d>), and one for ifupdown (F<if-up.d>).
Each is only ever run by the stack it belongs to. C<try-restart> does
nothing unless C<genfw.service> is active, so an installed but disabled
genfw never touches the firewall. A DHCP renewal does not trigger a rerun
and does not need one, since dynamic addresses are never written into the
rules. After changing a static address by hand, run
C<systemctl restart genfw.service>.

Nothing is enabled by installation: a host with no F<rules> file must not
start a firewall.

=head1 NOTES

A good firewall should restrict traffic on a per-interface basis as much as
possible.  This script tends to encourage this behavior...

=head1 BUGS

Only IPv4 is supported.

The C<ifcfg> address source only understands Red Hat style
F<network-scripts>; on other systems use the C<ip> source.

