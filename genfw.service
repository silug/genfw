# Early pass: bring the firewall up before any interface is configured, so
# no traffic is ever handled without rules. With the "ip" address source
# no addresses are known yet at this point, so the ruleset is complete
# except for address-dependent parts (anti-spoof filtering, NAT); those are
# added by genfw-online.service once the network is up, which this unit
# pulls in. With the "ifcfg" source this pass is already complete.
#
# This is the only unit to enable. Upgrading the package restarts it, which
# regenerates the rules with the new version.
[Unit]
Description=Configure firewall using genfw (before network)
Documentation=man:genfw(8)
DefaultDependencies=no
Wants=network-pre.target genfw-online.service
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/genfw -i

[Install]
WantedBy=multi-user.target
